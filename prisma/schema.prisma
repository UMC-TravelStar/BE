generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  user_id       String     @id
  nickname      String 
  password      String 
  name          String?
  birth         DateTime?
  phonenum      String?
  email         String?
  created_at    DateTime   @default(now())
  updated_at    DateTime   @updatedAt

  posts         Post[]
  day_schedules Day_schedule[]
  friendss      Friends[]
  friend_adds   Friend_add[]

  stars         Stars?
  subscrition   Subscrition?
  u_image       User_image?
  u_bgimage     User_bgimage?
}

model Post {
  post_id    Int      @id @default(autoincrement())
  title      String?
  content    String?
  music      String?
  feeling    String?
  feel_color String?
  views      Int      @default(0)
  storage    Int?
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  post_images Post_image[]

  user_id     String      
  user        User     @relation(fields: [user_id], references: [user_id])

  star_id     Int      
  star        Star     @relation(fields: [star_id], references: [star_id])
}

model Post_image {
  p_image_id  Int      @id @default(autoincrement())
  file_name   String?

  post_id     Int      
  post        Post     @relation(fields: [post_id], references: [post_id])
}

model Stars {
  stars_id    Int      @id @default(autoincrement())
  name        String?
  views       Int      @default(0)
  vote_num    Int?
  created_at  DateTime @default(now())

  stars       Star[]

  user_id     String   @unique
  user        User     @relation(fields: [user_id], references: [user_id])
}

model Star {
  star_id     Int      @id @default(autoincrement())
  region      String?

  posts       Post[]

  stars_id    Int      
  stars       Stars    @relation(fields: [stars_id], references: [stars_id])
}

model Day_schedule {
  day_id      Int      @id @default(autoincrement())
  date        DateTime?
  title       String?
  content     String?

  schedules   Schedule[]
  user_id     String    
  user        User     @relation(fields: [user_id], references: [user_id])
}

model Schedule {
  schedule_id       Int           @id @default(autoincrement())
  location          String?
  date_time         DateTime

  day_id            Int      
  day_schedules     Day_schedule  @relation(fields: [day_id], references: [day_id])
}

model Subscrition {
  sub_id      Int      @id @default(autoincrement())
  deadline    DateTime?
  method      Int?

  user_id     String   @unique
  user        User     @relation(fields: [user_id], references: [user_id])
}

model Friends {
  fr_id       Int      @id @default(autoincrement())

  user_id     String
  user        User     @relation(fields: [user_id], references: [user_id])
}

model Friend_add {
  add_id      Int      @id @default(autoincrement())
  fr_id       Int
  status      Int?

  user_id     String
  user        User     @relation(fields: [user_id], references: [user_id])
}

model User_image {
  u_image_id  Int      @id @default(autoincrement())
  file_name   String?

  user_id     String   @unique
  user        User     @relation(fields: [user_id], references: [user_id])
}

model User_bgimage {
  bg_image_id Int      @id @default(autoincrement())
  file_name   String?

  user_id     String   @unique
  user        User     @relation(fields: [user_id], references: [user_id])
}

model Search {
  search_id   Int      @id @default(autoincrement())
  word        String?
  number      Int      @default(0)
}